# Tchat API image.
#
# A thin wrapper over tchat-librechat -- this fork's own LibreChat build, from
# the source in this repository -- so that (a) changes under api/, packages/ and
# client/ reach production, and (b) runtime secrets come from Doppler at process
# start instead of a .env file on the host.
#
# The wrapper adds nothing but Doppler and the entrypoint: keeping it separate
# from the app image means a change to the secret-injection mechanism does not
# rebuild the application, and the base stays swappable via build args.
#
# `Tchat images` overrides LIBRECHAT_TAG with the commit SHA it just built, so
# tchat-api:<sha> and tchat-librechat:<sha> always carry the same source. The
# default below only applies to a local build.
ARG LIBRECHAT_IMAGE=ghcr.io/mrdjango/tchat-librechat
ARG LIBRECHAT_TAG=latest
FROM ${LIBRECHAT_IMAGE}:${LIBRECHAT_TAG}

USER root
RUN apk add --no-cache curl gnupg \
    && curl -Ls --tlsv1.2 --proto "=https" --retry 3 https://cli.doppler.com/install.sh | sh \
    && doppler --version
COPY entrypoint.sh /usr/local/bin/tchat-entrypoint
RUN chmod 0755 /usr/local/bin/tchat-entrypoint

# Baked rather than bind-mounted, so the config a release runs is the config
# that release was built from. The host copy under the Komodo run directory is
# written once at stack setup and never refreshed, so a mounted file silently
# pins itself to whatever was there on setup day -- which is how a build
# expecting `modelSpecs.imageList` came up against a config without it.
COPY librechat.yaml /app/librechat.yaml
USER node

# Doppler injects the tchat-be-fe config into the process environment and execs
# the server, so no secret is ever written to disk or baked into a layer.
ENTRYPOINT ["tchat-entrypoint"]
CMD ["npm", "run", "backend"]
