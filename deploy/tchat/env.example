# Tchat configuration reference.
#
# This file is documentation, not a deployment artifact — nothing here is read
# at runtime and no real value belongs in it. Set the values in Doppler:
#
#   doppler secrets set -p tchat-be-fe -c prd NAME=value
#   doppler secrets   -p tchat-be-fe -c prd          # review
#
# Two owners, on purpose:
#   [doppler] tchat-be-fe/prd, fetched by tchat-api and tchat-broker at start.
#   [komodo]  the tchat-production stack environment, interpolated into
#             compose.production.yml. Written from Doppler by the deploy path.
#   [compose] declared next to the service it names; listed in
#             DOPPLER_PRESERVE_ENV so Doppler does not override topology.

# ---------------------------------------------------------------- [komodo] ---
# Immutable release tag, the full 40-character commit SHA. Never `main`.
TCHAT_IMAGE_TAG=0000000000000000000000000000000000000000
TCHAT_API_IMAGE=ghcr.io/mrdjango/tchat-api
TCHAT_BROKER_IMAGE=ghcr.io/mrdjango/tchat-broker
# Doppler service token scoped to tchat-be-fe/prd. The only secret Komodo holds.
DOPPLER_TOKEN=dp.st.prd.xxxxxxxxxxxxxxxxxxxxxxxx
DOPPLER_PROJECT=tchat-be-fe
DOPPLER_CONFIG=prd
# Meilisearch reads this directly; it has no Doppler client of its own. Must
# match MEILI_MASTER_KEY in Doppler, which is what tchat-api authenticates with.
MEILI_MASTER_KEY=
# Only needed with `--profile rag`.
TCHAT_VECTOR_USER=
TCHAT_VECTOR_PASSWORD=

# --------------------------------------------------------------- [compose] ---
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://tchat-mongo:27017/tchat
# Cloudflare + edge nginx + tchat-proxy. Wrong value => every user shares one
# rate-limit bucket, or a spoofable client IP.
TRUST_PROXY=3
MEILI_HOST=http://tchat-meili:7700
CONFIG_PATH=/app/librechat.yaml
# The only model destination Tchat knows about.
TCHAT_BROKER_BASE_URL=http://tchat-broker:8081/v1
TCHAT_BROKER_PORT=8081
DJANGO_INTERNAL_BASE_URL=http://backend:8000
MODELS_GATEWAY_INTERNAL_BASE_URL=http://models-gateway:3000

# --------------------------------------------------------------- [doppler] ---
# Branding. APP_TITLE renames the tab and transactional email sender; the
# favicon/logo/manifest are replaced by deploy/tchat/nginx.conf instead.
APP_TITLE=Tchat
CUSTOM_FOOTER=Tchat by TensorGrid
HELP_AND_FAQ_URL=https://tensorgrid.space

DOMAIN_CLIENT=https://chat.tensorgrid.space
DOMAIN_SERVER=https://chat.tensorgrid.space
# Public URL of the admin console. The API compares a login's redirect origin
# against this to decide whether the sign-in came from the admin panel. Left
# unset it defaults to localhost:3000, the comparison fails, and an admin
# signing in is bounced to the ordinary chat client instead.
ADMIN_PANEL_URL=https://tchat-admin.tensorgrid.space
# Session key for the admin console; the panel refuses to start without it.
# Lives in the Komodo stack environment, not here.
# ADMIN_PANEL_SESSION_SECRET=<openssl rand -hex 32>

# Drops every built-in provider (openAI, anthropic, google, bedrock, azure,
# assistants) from the endpoint menu. Custom endpoints are unaffected, so the
# two TensorGrid endpoints in librechat.yaml are all that remains. Combined
# with `modelSpecs.enforce: true` there is nothing for a user to switch to.
ENDPOINTS=agents

# Session and credential crypto. Generate independently, 32 bytes each:
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
MEILI_MASTER_KEY=

# Day-one auth posture: no self-service signup, no social providers. Accounts
# are created by an operator (see README) until the Django IdP exists.
ALLOW_REGISTRATION=false
ALLOW_EMAIL_LOGIN=true
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
SEARCH=true

# Tchat-Mobile (the native Android/iOS client) sends a browser User-Agent to pass the
# ua-parser-js middleware, but if that parse ever fails, this stops the violation system
# accumulating ban points against it and eventually locking the account out. Prerequisite for
# any sustained testing/use from the mobile client — see Tchat-Mobile/TCHAT.md.
NON_BROWSER_VIOLATION_SCORE=0

# Broker wiring.
# Ingress key Tchat presents to the broker. Any random 32+ byte string; it is
# not a Gateway token and grants nothing on its own.
TCHAT_BROKER_SHARED_KEY=
# Signs broker -> Django. Must equal TCHAT_INTEGRATION_SECRET in
# tensorgrid-be-fe/prd_backend.
TCHAT_INTEGRATION_SECRET=
# Signs broker -> Models Gateway. Must equal the TensorGrid stack's
# TENSORGRID_INTEGRATION_SECRET exactly.
TENSORGRID_INTEGRATION_SECRET=

# Image generation (`image_gen_oai` agent toolkit), off until both are set.
# The base URL is the broker, not OpenAI, so images bill to the signed-in
# user's Gateway token exactly like a chat completion does; the key is the
# same ingress key above, and the broker replaces it before forwarding.
# Setting these makes the tool selectable by every user who can build an agent.
# IMAGE_GEN_OAI_BASEURL=http://tchat-broker:8081/v1
# IMAGE_GEN_OAI_API_KEY=<same value as TCHAT_BROKER_SHARED_KEY>
# IMAGE_GEN_OAI_MODEL=gpt-image-1

# Gemini image generation (`gemini_image_gen` toolkit). Google's SDK is aimed at
# the broker rather than Google, so the Gateway relays it natively and the image
# bills to the signed-in user. The "API key" is the broker ingress key; no
# Google credential is involved.
# GEMINI_IMAGE_GEN_BASEURL=http://tchat-broker:8081
# GEMINI_API_KEY=<same value as TCHAT_BROKER_SHARED_KEY>
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-c
# Public inference origin the broker relays to.
TENSORGRID_API_BASE_URL=https://api.tensorgrid.space
# Must match RESERVED_TOKEN_NAMES in TensorGrid's model_hub/views.py, or the
# token the broker mints would become visible in the user's API-key list.
TCHAT_BROKER_TOKEN_NAME=TCHAT
TCHAT_BROKER_TOKEN_LIFETIME_DAYS=30
TCHAT_BROKER_TOKEN_CACHE_SECONDS=3600
TCHAT_BROKER_SUBJECT_CACHE_SECONDS=900
TCHAT_BROKER_REQUEST_TIMEOUT_MS=15000

# OIDC — scaffolded, inert until Django is an IdP. See OIDC.md for the cutover.
OPENID_ISSUER=
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_SESSION_SECRET=
OPENID_SCOPE=openid profile email
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_BUTTON_LABEL=Continue with TensorGrid
OPENID_AUTO_REDIRECT=false
OPENID_USE_PKCE=false
OPENID_USERNAME_CLAIM=
OPENID_NAME_CLAIM=
OPENID_EMAIL_CLAIM=
OPENID_POST_LOGOUT_REDIRECT_URI=https://tensorgrid.space
